rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only authenticated users may read the rooms collection (used by AdminSync)
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      // Writes come exclusively from the Admin SDK (Cloud Functions / server)
      allow write: if false;
    }

    // Allow authenticated users to write activity logs (client-side logger)
    match /activity_logs/{logId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
